# Optional: API keys (override secrets.toml if set here)
OPENAI_API_KEY=
GENIMI_API_KEY=

MINERU_MODEL_SOURCE=modelscope
MINERU_OFFICE_CONVERT_TIMEOUT_SECONDS=600

# MinerU 4: quality and inference connection are configured independently.
# Fallback for direct service calls; HTTP tier defaults to standard independently.
MINERU_DEFAULT_TIER=standard
MINERU_DEFAULT_METHOD=auto
# CPU small models keep GPU memory available to the Docker VLM service.
MINERU_MODEL_SMALL_BACKEND=onnx
MINERU_MODEL_VLM_SERVER_URL=http://127.0.0.1:30000
MINERU_MODEL_VLM_MODEL=mineru4
MINERU_MODEL_VLM_HTTP_TIMEOUT=600
MINERU_MODEL_VLM_MAX_CONCURRENCY=8
# MINERU_MODEL_VLM_API_KEY=
# Multiple Docker endpoints: unset MINERU_MODEL_VLM_SERVER_URL and use this list.
# MINERU_VLLM_SERVER_URLS=http://127.0.0.1:30000,http://127.0.0.1:30001
# MINERU_HOME=/var/lib/mineru
# Docker Compose overrides (GPU/port must match the available hardware).
MINERU_DOCKER_GPU_ID=0
MINERU_DOCKER_PORT=30000
MINERU_DOCKER_GPU_MEMORY=0.15

# FastAPI authentication toggle (override secrets.toml)
FASTAPI_AUTH=true

# Scheduler / MinerU timeouts (seconds)
MINERU_TASK_HARD_TIMEOUT_SECONDS=1800
MINERU_DEFAULT_HARD_TIMEOUT_SECONDS=1800
MINERU_IMAGES_HARD_TIMEOUT_SECONDS=1800
MINERU_SCI_HARD_TIMEOUT_SECONDS=600
MINERU_SCI_TIMEOUT_SECONDS=110

# GPU scheduler device list
GPU_IDS=0,1,2

# Vision routing defaults
VISION_PROVIDER=vllm
VISION_MODEL=Qwen/Qwen3.5-397B-A17B-GPTQ-Int4

VISION_PROVIDER_CHOICES=vllm

VISION_MODELS_VLLM=Qwen/Qwen3.5-397B-A17B-GPTQ-Int4
VISION_DEFAULT_MODEL_VLLM=Qwen/Qwen3.5-397B-A17B-GPTQ-Int4

# Default context window for vision models is 2, can be overridden per request
VISION_CONTEXT_WINDOW=1

# vLLM endpoint config (VLLM_API_KEY is optional auth only)
VLLM_BASE_URLS=http://localhost:8000/v1

# Path to pandoc binary used for Markdown conversion
PANDOC_PATH=pandoc

FASTAPI_BEARER_TOKEN=YourSecureTokenHere
