# Application environment > .env > .secrets/secrets.toml.
# Copy deploy/secrets.example.toml to .secrets/secrets.toml on first setup.
FASTAPI_AUTH=true
FASTAPI_BEARER_TOKEN=
# FASTAPI_MIDDLEWARE_SECRECT_KEY=

# MinerU quality fallback for direct service calls.
# HTTP requests use their submitted tier, or advanced when omitted.
MINERU_DEFAULT_TIER=advanced
MINERU_DEFAULT_METHOD=auto
MINERU_MODEL_SOURCE=modelscope
MINERU_MODEL_SMALL_BACKEND=onnx
# Explicit ONNX CPU budget per model session; API/parse PM2 env also sets this.
MINERU_INTRA_OP_NUM_THREADS=16
MINERU_INTER_OP_NUM_THREADS=1
# MINERU_HOME: optional persistent model directory configured for this deployment.

# MinerU model inference endpoint; this is not the document API or vision model.
MINERU_MODEL_VLM_SERVER_URL=http://127.0.0.1:30000
MINERU_MODEL_VLM_MODEL=mineru4
MINERU_MODEL_VLM_HTTP_TIMEOUT=600
MINERU_MODEL_VLM_MAX_CONCURRENCY=8
# Pages per SDK processing window, not a document page limit.
# API and parse PM2 templates explicitly use the same value.
MINERU_PROCESSING_WINDOW_SIZE=64
# Shared across API and Celery on this host. Same directory/count in every process.
MINERU_PARSE_SLOTS=3
# Per API scheduler dispatch width; actual parsing still uses the shared slots.
MINERU_SCHEDULER_WORKERS=3
# MINERU_PARSE_SLOT_DIR: unset uses tiangong_mineru_parse_slots in the system temp directory.
MINERU_PARSE_SLOT_WAIT_SECONDS=1800
# MINERU_MODEL_VLM_API_KEY=
# Three-GPU internal DP uses the single URL above; no URL list is needed.
# Independent containers only: remove the single URL before setting this list.
# This list rotates within each process, without shared scheduling or failover.
# MINERU_VLLM_SERVER_URLS=http://127.0.0.1:30000,http://127.0.0.1:30001

# Docker configuration. The parallel launcher fixes project mineru-vlm-parallel.
# Its PM2 env overrides port/memory to 30000/0.10; edit that template to change them.
# GPU_ID only applies to the single-GPU base Compose; parallel binds 0,1,2.
MINERU_DOCKER_GPU_ID=0
MINERU_DOCKER_PORT=30000
MINERU_DOCKER_GPU_MEMORY=0.10
# Model image versions can be overridden per host without changing the shared templates.
MINERU_DOCKER_BASE_IMAGE=vllm/vllm-openai:v0.21.0
MINERU_DOCKER_VLLM_VERSION=0.21.0
MINERU_DOCKER_FASTAPI_VERSION=0.141.1
MINERU_DOCKER_STARLETTE_VERSION=1.7.0
MINERU_DOCKER_IMAGE_TAG=4.0.7-vllm0.21.0
# MinerU2.5 Pro checkpoint omits lm_head.weight; newer vLLM needs the top-level tie flag.
MINERU_DOCKER_TIE_WORD_EMBEDDINGS=true
# Parallel deployment model/cache volumes; override to reuse an existing cache.
# MINERU_DOCKER_MODEL_VOLUME=mineru-vlm-models
# MINERU_DOCKER_CACHE_VOLUME=mineru-vlm-cache
# Set true only when both named volumes already exist and are managed externally.
# MINERU_DOCKER_VOLUMES_EXTERNAL=false

# Existing application scheduler slots; these do not bind the Docker GPU.
GPU_IDS=0
MINERU_TASK_HARD_TIMEOUT_SECONDS=1800
MINERU_DEFAULT_HARD_TIMEOUT_SECONDS=1800
MINERU_IMAGES_HARD_TIMEOUT_SECONDS=1800
MINERU_SCI_HARD_TIMEOUT_SECONDS=300
MINERU_SCI_TIMEOUT_SECONDS=110
MINERU_OFFICE_CONVERT_TIMEOUT_SECONDS=600
# MINERU_TEXT_LAYER_CHECKBOX_RECONCILE=true
# MINERU_TEXT_LAYER_TIMEOUT_SECONDS=30

# API and every worker must resolve to the same broker, backend and workspace.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_MINERU_QUEUE=queue_normal
CELERY_TASK_URGENT_QUEUE=queue_urgent
# Explicit two-stage routing matching ecosystem.two_stage.celery.json.
CELERY_TASK_PARSE_QUEUE=queue_parse_gpu
CELERY_TASK_VISION_QUEUE=queue_vision
CELERY_TASK_DISPATCH_QUEUE=queue_dispatch
CELERY_TASK_MERGE_QUEUE=default
# MINERU_TASK_STORAGE_DIR: unset uses tiangong_mineru_tasks in the system temp directory.
# Durable source/checkpoints/results; all API and worker processes must share this directory.
# Unset resolves to output/jobs under the repository (independent of temporary uploads).
# MINERU_JOB_STORE_DIR=output/jobs
MINERU_TWO_STAGE_HARD_TIMEOUT_SECONDS=1800
# Bound each two-stage fan-out; next wave reuses completed image files.
MINERU_VISION_WAVE_SIZE=32
# Increment when the same served model name is replaced by different weights.
MINERU_EXECUTION_PROFILE_REVISION=2
# Both Celery apps must use matching budgets when sharing a Redis broker.
CELERY_VISIBILITY_TIMEOUT=21600
CELERY_RESULT_EXPIRES=86400

# Legacy two_stage_enqueue.py settings only; batch_parse uses CLI arguments.
# batch_parse defaults: port 7770, 2 in flight, 21600 seconds polling budget.
# The legacy script must explicitly select production port 7770.
# TWO_STAGE_BASE=http://127.0.0.1:7770
TWO_STAGE_MAX_IN_FLIGHT=6
TWO_STAGE_POLL_INTERVAL=1
TWO_STAGE_POLL_TIMEOUT=800

# Separate image-description service. Set the URL/model for your deployment.
VISION_PROVIDER=vllm
VISION_PROVIDER_CHOICES=vllm
VISION_MODEL=nv-community/Qwen3.8-Flash-Next-NVFP4
VISION_MODELS_VLLM=nv-community/Qwen3.8-Flash-Next-NVFP4
VISION_DEFAULT_MODEL_VLLM=nv-community/Qwen3.8-Flash-Next-NVFP4
# Number of neighboring content blocks; no request-level override.
VISION_CONTEXT_WINDOW=1
# Per-request rolling image window, not the Celery vision worker concurrency.
VISION_BATCH_SIZE=3
VLLM_BASE_URLS=http://127.0.0.1:8000/v1
# VLLM_API_KEY=
VLLM_ENABLE_THINKING=false
# Qwen3.8 Flash Next non-thinking deployment profile; generic code defaults remain 1/1/40/2.
VLLM_VISION_TEMPERATURE=0.2
VLLM_VISION_TOP_P=0.8
VLLM_VISION_TOP_K=20
VLLM_VISION_PRESENCE_PENALTY=0
VLLM_VISION_MIN_P=0.0
VLLM_VISION_REPETITION_PENALTY=1.0
VLLM_VISION_TIMEOUT_SECONDS=180
# TCP/TLS budget; capped by TIMEOUT_SECONDS when that is shorter.
VLLM_VISION_CONNECT_TIMEOUT_SECONDS=5
# Try the next configured endpoint instead of repeating SDK retries on a failing one.
VLLM_VISION_MAX_RETRIES=0
# Shared across all local API/worker processes, per unique endpoint.
VLLM_VISION_ENDPOINT_SLOTS=16
VLLM_VISION_SLOT_WAIT_SECONDS=180
VLLM_VISION_COOLDOWN_SECONDS=30
# One PM2 monitor shares health with API/workers through the same slot directory.
VLLM_VISION_HEALTH_INTERVAL_SECONDS=10
# Total deadline for health + model-list GETs per endpoint (no inference).
VLLM_VISION_HEALTH_TIMEOUT_SECONDS=2
# Must exceed the interval; stale records fall back to passive circuit recovery.
VLLM_VISION_HEALTH_TTL_SECONDS=30
# VLLM_VISION_SLOT_DIR: unset uses tiangong_vision_slots in the system temp directory.
# Explicit opt-in for private prompt debugging; disabled even if Loguru logs DEBUG.
VISION_LOG_PROMPTS=false
# Optional providers require corresponding vision routing configuration.
# OPENAI_API_KEY=
# GENIMI_API_KEY=

PANDOC_PATH=pandoc

# API HTTP capacity (independent of MINERU_PARSE_SLOTS)
API_WORKERS=4
API_BIND=0.0.0.0:7770
API_WORKER_TIMEOUT=1900
API_MAX_REQUESTS=5000
API_MAX_REQUESTS_JITTER=500
