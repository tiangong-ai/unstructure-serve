# Application environment > .env > .secrets/secrets.toml.
# Copy deploy/secrets.example.toml to .secrets/secrets.toml on first setup.
FASTAPI_AUTH=true
FASTAPI_BEARER_TOKEN=
# FASTAPI_MIDDLEWARE_SECRECT_KEY=

# MinerU quality fallback for direct service calls.
# HTTP requests use their submitted tier, or standard when omitted.
MINERU_DEFAULT_TIER=standard
MINERU_DEFAULT_METHOD=auto
MINERU_MODEL_SOURCE=modelscope
MINERU_MODEL_SMALL_BACKEND=onnx
# MINERU_HOME=/var/lib/mineru

# MinerU model inference endpoint; this is not the document API or vision model.
MINERU_MODEL_VLM_SERVER_URL=http://127.0.0.1:30000
MINERU_MODEL_VLM_MODEL=mineru4
MINERU_MODEL_VLM_HTTP_TIMEOUT=600
MINERU_MODEL_VLM_MAX_CONCURRENCY=8
# MINERU_MODEL_VLM_API_KEY=
# For multiple containers, remove the single URL before setting this list.
# MINERU_VLLM_SERVER_URLS=http://127.0.0.1:30000,http://127.0.0.1:30001

# Docker GPU/port selection. Keep the application endpoint above in sync.
# COMPOSE_PROJECT_NAME=unstructure-serve
MINERU_DOCKER_GPU_ID=0
MINERU_DOCKER_PORT=30000
MINERU_DOCKER_GPU_MEMORY=0.15

# Existing application scheduler slots; these do not bind the Docker GPU.
GPU_IDS=0
MINERU_TASK_HARD_TIMEOUT_SECONDS=1800
MINERU_DEFAULT_HARD_TIMEOUT_SECONDS=1800
MINERU_IMAGES_HARD_TIMEOUT_SECONDS=1800
MINERU_SCI_HARD_TIMEOUT_SECONDS=300
MINERU_SCI_TIMEOUT_SECONDS=110
MINERU_OFFICE_CONVERT_TIMEOUT_SECONDS=600
# MINERU_TEXT_LAYER_CHECKBOX_RECONCILE=true
# MINERU_TEXT_LAYER_TIMEOUT_SECONDS=30

# API and every worker must resolve to the same broker, backend and workspace.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_MINERU_QUEUE=queue_normal
CELERY_TASK_URGENT_QUEUE=queue_urgent
# Explicit two-stage routing matching ecosystem.two_stage.celery.json.
CELERY_TASK_PARSE_QUEUE=queue_parse_gpu
CELERY_TASK_VISION_QUEUE=queue_vision
CELERY_TASK_DISPATCH_QUEUE=queue_dispatch
CELERY_TASK_MERGE_QUEUE=default
# MINERU_TASK_STORAGE_DIR=/tmp/tiangong_mineru_tasks
# CELERY_RESULT_EXPIRES=3600

# Separate image-description service. Set the URL/model for your deployment.
VISION_PROVIDER=vllm
VISION_PROVIDER_CHOICES=vllm
VISION_MODEL=Qwen/Qwen3.5-397B-A17B-GPTQ-Int4
VISION_MODELS_VLLM=Qwen/Qwen3.5-397B-A17B-GPTQ-Int4
VISION_DEFAULT_MODEL_VLLM=Qwen/Qwen3.5-397B-A17B-GPTQ-Int4
# Number of neighboring content blocks; no request-level override.
VISION_CONTEXT_WINDOW=1
VISION_BATCH_SIZE=3
VLLM_BASE_URLS=http://127.0.0.1:8000/v1
# VLLM_API_KEY=
# VLLM_ENABLE_THINKING=false
# Optional providers require corresponding vision routing configuration.
# OPENAI_API_KEY=
# GENIMI_API_KEY=

PANDOC_PATH=pandoc
