# Merge into the existing private .env; do not overwrite credentials or paths.
# Application-only profile, shared by every node regardless of its GPU count.
# GPUStack owns the model containers. Start app4 + ordinary, never model/model4.
API_WORKERS=4
MINERU_PARSE_SLOTS=4
MINERU_SCHEDULER_WORKERS=4
MINERU_PROCESSING_WINDOW_SIZE=64
MINERU_MODEL_VLM_MAX_CONCURRENCY=8
MINERU_INTRA_OP_NUM_THREADS=16
MINERU_INTER_OP_NUM_THREADS=1
MINERU_TASK_HARD_TIMEOUT_SECONDS=1800
MINERU_DEFAULT_HARD_TIMEOUT_SECONDS=1800
MINERU_IMAGES_HARD_TIMEOUT_SECONDS=1800
MINERU_TWO_STAGE_HARD_TIMEOUT_SECONDS=1800
MINERU_PARSE_SLOT_WAIT_SECONDS=1800
CELERY_VISIBILITY_TIMEOUT=21600
CELERY_RESULT_EXPIRES=86400
VISION_BATCH_SIZE=3
VISION_PROVIDER=vllm
VISION_PROVIDER_CHOICES=vllm
VLLM_VISION_ENDPOINT_SLOTS=8
VLLM_VISION_TEMPERATURE=0.2
VLLM_VISION_TOP_P=0.8
VLLM_VISION_TOP_K=20
VLLM_VISION_PRESENCE_PENALTY=0
VLLM_VISION_REPETITION_PENALTY=1
VLLM_VISION_MIN_P=0
# Fill these on each node; use route identities from the deployment's GPUStack.
# MINERU_MODEL_VLM_SERVER_URL=http://gateway/model/proxy/MINERU_ROUTE_ID
# MINERU_MODEL_VLM_MODEL=mineru4
# MINERU_MODEL_VLM_API_KEY=
# VLLM_BASE_URLS=http://gateway/model/proxy/QWEN_ROUTE_ID/v1
# VLLM_API_KEY=
# Keep the current model identity, authentication, storage/slot directories and
# execution profile revision. Drain all consumers before changing shared limits.
