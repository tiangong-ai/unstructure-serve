{
  "apps": [
    {
      "name": "mineru-vlm-docker-0",
      "cwd": ".",
      "script": "docker",
      "args": "compose --env-file .env -p mineru-gpu0 -f deploy/mineru-vllm/compose.mineru.yaml up --build mineru-vlm",
      "interpreter": "none",
      "autorestart": true,
      "max_restarts": 5,
      "min_uptime": "60s",
      "exp_backoff_restart_delay": 10000,
