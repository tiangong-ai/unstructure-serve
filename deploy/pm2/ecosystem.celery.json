{
  "apps": [
    {
      "name": "celery-worker",
      "cwd": ".",
      "script": ".venv/bin/celery",
      "interpreter": ".venv/bin/python",
      "args": "-A src.services.celery_app worker -l info -Q queue_urgent,queue_normal -P threads -c 16 --prefetch-multiplier=1",
      "env": {
        "CELERY_TASK_MINERU_QUEUE": "queue_normal",
        "CELERY_TASK_URGENT_QUEUE": "queue_urgent",
        "MINERU_MODEL_SMALL_BACKEND": "onnx",
        "MINERU_MODEL_ONNX_DEVICE": "cpu",
        "MINERU_INTRA_OP_NUM_THREADS": "16",
        "MINERU_INTER_OP_NUM_THREADS": "1"
      },
      "kill_timeout": 1900000
    }
  ]
}
